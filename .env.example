# GitHub OAuth (device flow)
GH_CLIENT_ID=your_client_id_here
GH_CLIENT_SECRET=your_client_secret_here

# Hugging Face Space (optional)
HF_SPACE_URL=https://your-space.hf.space

# Supabase (optional, for persistent sessions)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# LangSmith tracing
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=hiem-app

# GitHub App JWT (alternative to OAuth)
# GH_PRIVATE_KEY_PATH=/path/to/private-key.pem
# GH_INSTALLATION_ID=12345678